__pycache__/
*.pyc

# Rust 编译产物与运行日志
rust/target/
rust/logs/

# 安装包生成物（保留同目录下的 .md / .cmd 模板源）
安装包/*.exe

# 已清理的废弃目录，防止再次入库
素材_未使用/
qa/

# 全局日志
*.log
